# Optional server configuration. Set environment variables in the host settings.
# The server does not read this file automatically.
PORT=4173
KORA_HOST=127.0.0.1
# On an HTTPS deployment behind a reverse proxy:
# KORA_SECURE_COOKIE=1
# KORA_ORIGIN=https://your-game.example
# KORA_DATA_DIR=/data/kora-bay
# ICE configuration is shared with authenticated players for WebRTC setup.
# Configure a TURN service to support networks that cannot connect directly.
# KORA_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turns:turn.example.com:5349","username":"REPLACE","credential":"REPLACE"}]
